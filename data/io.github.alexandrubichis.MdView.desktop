[Desktop Entry]
Type=Application
Name=MD Viewer
GenericName=Markdown Viewer
Comment=View Markdown documents
Exec=mdview %U
Icon=io.github.alexandrubichis.MdView
Terminal=false
Categories=Office;Viewer;GTK;GNOME;
MimeType=text/markdown;text/x-markdown;
Keywords=markdown;md;viewer;preview;readme;
StartupNotify=true
